; Engine configuration file.
; Open this folder in Godot 4.3+ (Project Manager -> Import -> select this file).

config_version=5

[application]

config/name="Sunset Shores"
config/description="An original open-world driving and action sandbox, built entirely in code."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.05, 0.12, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096

[shader_globals]

night={
"type": "float",
"value": 0.0
}
