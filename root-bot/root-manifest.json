{
  "id": "ADJ57ej7hgm-c7xE-NfyFQ",
  "version": "1.1.0",
  "package": {
    "server": {
      "launch": "dist/main.js",
      "deploy": [
        "dist"
      ],
      "nodeModules": [
        "node_modules"
      ]
    }
  },
  "permissions": {
    "community": {
      "manageRoles": true,
      "kick": true,
      "createBan": true
    },
    "channel": {
      "fullControl": true,
      "createMessage": true,
      "viewMessageHistory": true,
      "deleteMessageOther": true,
      "managePinnedMessages": true,
      "createMessageMention": true,
      "createMessageReaction": true
    }
  }
}
