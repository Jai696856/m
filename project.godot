; Engine configuration file.
; Open this folder in Godot 4.3+ (Project Manager -> Import -> select this file).

config_version=5

[application]

config/name="Sakura Spirit Defense"
config/description="A 3D anime tower defense game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.075, 0.1, 0.19, 1)
boot_splash/image="res://art/logo.png"
boot_splash/fullsize=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
